# Backend Proxy Target (Vite development server proxy target)
VITE_API_PROXY_TARGET=http://localhost:8080

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api

# ONLYOFFICE Document Server API script URL
# If running ONLYOFFICE locally on port 80:
# VITE_ONLYOFFICE_API_URL=http://localhost:80/web-apps/apps/api/documents/api.js
# If running ONLYOFFICE via Docker (on port 8081 for example):
# VITE_ONLYOFFICE_API_URL=http://localhost:8081/web-apps/apps/api/documents/api.js
VITE_ONLYOFFICE_API_URL=http://localhost:80/web-apps/apps/api/documents/api.js

# ONLYOFFICE Callback URL
# Inside Docker, ONLYOFFICE needs to resolve the host machine.
# On Windows/Mac Docker Desktop, use 'host.docker.internal' instead of 'localhost'.
VITE_ONLYOFFICE_CALLBACK_URL=http://host.docker.internal:8080/api/onlyoffice/callback
